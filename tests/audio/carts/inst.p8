pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- custom instrument (sfx waveforms 8..15) regression cart
-- the audio suite runs it and reads the exported .wav files back with
-- tests/tools/wavnotes.py; tests/audio/expected/inst.txt was recorded from
-- PICO-8 0.2.7 with platforms/macos/oracle_audio.sh --record
--
-- instruments
--  0 triangle, volume 7..1, speed 4, no loop (shows the clock by volume)
--  1 key 24..31, speed 4, loop 0-8
--  2 slide inside the instrument
--  3 custom notes inside an instrument (they do not nest)
--  6 key 24..55, speed 4 (shows the clock by pitch)
-- cases (same pitch = no retrigger unless noted)
--  10 same pitch x4          11 pitch change retriggers
--  12 drop retriggers         13 volume 0 note: clock runs on
--  16 fade out / fade in      17 instrument change retriggers
--  18 arpeggio on top         20 nested custom notes
--  21 instrument loop         22 volume change only
--  30 fade in retriggers      31 fade out does not
--  32 volume 0 note           33 empty note retriggers
--  34 slide same pitch        35 slide new pitch: no retrigger
--  36 vibrato                 37/38 arpeggios
--  39 plain then custom       42 fade outs
--  43 silent first note       45 volume 0 note with new pitch
--  46 drop, then same pitch
export("inst_%d.wav")
