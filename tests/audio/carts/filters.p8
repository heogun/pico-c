version 43
__lua__
-- sfx filter (byte 64) regression cart
-- the audio suite exports it and reads the .wav files back with
-- tests/tools/wavnotes.py; tests/audio/expected/filters.txt was recorded
-- from PICO-8 0.2.7 with platforms/macos/oracle_audio.sh --record
--
-- instruments: 0 triangle, 1 triangle with buzz (32 notes, key 24)
--   8 triangle (reference)   9..13 buzz on waveforms 0,2,3,4,5
--  14 square  15 dampen 1  16 dampen 2
--  17 detune 1 (triangle: second voice a fourth below)
--  18 detune 2 (triangle: second voice a fifth above)
--  19 reverb 1  20 reverb 2  25 no reverb (short notes)
--  21 noiz at key 24  22 noiz at key 48
--  23 buzz from the instrument  24 buzz from the sound
export("filters_%d.wav")
