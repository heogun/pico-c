pico-8 cartridge // http://www.pico8.com
version 41
__lua__
-- exercise the .p8 writer with a spread of known bytes
poke(0x0000,0x12) poke(0x0001,0xab) poke(0x0002,0x00) poke(0x0003,0xff)
poke(0x0010,0x78) poke(0x1fff,0x77)
poke(0x3000,0x0f) poke(0x30ff,0x1e)
poke(0x2000,0x3c) poke(0x2001,0x21) poke(0x2fff,0x5a)
-- sfx 0 note: pitch=0x0c wave=2 vol=5 effect=1  => lsb 0x8c msb 0x1a
poke(0x3200,0x8c) poke(0x3201,0x1a)
poke(0x3241,0x20) -- sfx 0 speed (header is at +64)
-- sfx 2 note: pitch=0x30 wave=0x0f vol=7 effect=7 => lsb 0xf0|0x30? compute in file below
poke(0x3200+2*68+0,0x30|(3<<6)) poke(0x3200+2*68+1,((7|(1<<3))<<4)|(7<<1)|1)
poke(0x3200+2*68+64,0x00) poke(0x3200+2*68+65,0x40)
-- music pattern 0: ch0=5 ch1=0x41 ch2=0x42|fstop ch3=0x43
poke(0x3100,0x05) poke(0x3101,0x41) poke(0x3102,0x42|0x80) poke(0x3103,0x43)
local ok = save("p8save_out.p8")
printh("save="..tostr(ok))
stop()
