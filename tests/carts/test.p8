pico-8 cartridge
version 8
__lua__
-- pico-c test cart
function _init()
  cls(0)
  poke(0x5f2d,6)
  print("pico-c test",24,60,7)
  flr=0
end

function _update()
  if btn(0) then flr=1 end
  if btn(1) then flr=2 end
  if btn(2) then flr=3 end
  if btn(3) then flr=4 end
  if btn(4) then flr=5 end
  if btn(5) then flr=6 end
end

function _draw()
  cls(0)
  spr(flr,64,64)
  print("btn: "..flr,0,120,7)
  print("hello pico-c!",8,8,11)
  print("spr "..flr,8,16,8)
  rect(0,0,127,127,12)
  rectfill(10,10,20,20,9)
  circ(64,64,30,14)
end
