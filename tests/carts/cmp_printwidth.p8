pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
printh("a="..print("abcd"))
printh("b="..print("⬆️"))
printh("c="..print("あ😀"))
printh("d="..print("a\nb"))
printh("e="..print(chr(9)))
printh("f="..print(chr(16)))
printh("g="..print(chr(1)))
printh("h="..print("한"))
printh("i="..print("a⬆️b"))
printh("j="..print("  "))
printh("k="..print(chr(128)..chr(255)))
printh("l="..print(chr(127)))
printh("m="..print("ˇ…☉"))
printh("n="..print(chr(13)))
printh("o="..print("x\ty"))
stop()
